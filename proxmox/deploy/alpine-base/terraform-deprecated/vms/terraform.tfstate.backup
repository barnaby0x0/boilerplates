            "overwrite": true,
            "source_file": [],
            "source_raw": [
              {
                "data": "#cloud-config\npackage_upgrade: false\nusers:\n  - name: user\n    groups: [adm, sudo]\n    lock-passwd: false\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    passwd: $6$tGz.h5alKsD5IOP2$yfQ1RTnXjdLnmCQxFG70Jf3d24YAb8Bsb/qZ/iW0aokkahPQ8qlRhgC2ZpVYkcK.CQh579k3IF3f2LTDAMsKH/\n    ssh_authorized_keys: \n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP1oFq0GYt8j7vg2nNAJNzwBtqrdOUDp8CMQwLRiz4Vz user@ull\n\n\nssh_pwauth: True ## This line enables ssh password authentication\n\n\n\n# commands from here are run as root\nruncmd:\n  - echo \"Ready\"\n  - usermod -u 1000 user\n  - groupmod -g 1000 user\n  - wget http://192.168.1.29:8080/files/immich/init.sh\n  - wget http://192.168.1.29:8080/files/immich/immich.tgz\n  - tar xzf $PWD/immich.tgz\n  - cp $PWD/immich/env /tmp \u0026\u0026 cp $PWD/immich/restoredb.sh /tmp\n  - bash $PWD/immich/install-immich.sh\n  - chmod +x $PWD/init.sh\n  - ls -la \u003e /home/user/log\n  - echo $PWD \u003e\u003e /home/user/log\n  - chmod 777 /home/user/log\n  - su - user -c 'echo $(id -u) \u003e\u003e /home/user/log'\n  - su - user -c 'echo $(id -g) \u003e\u003e /home/user/log'\n  - $PWD/init.sh\n\n",
                "file_name": "immichalpine-ci-user.yml",
                "resize": 0
              }
            ],
            "timeout_upload": 1800
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        },
        {
          "index_key": "nginxproxymanager",
