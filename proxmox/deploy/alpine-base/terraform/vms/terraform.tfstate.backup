            "id": "snippets:snippets/nginx-ci-user.yml",
            "node_name": "pve",
            "overwrite": true,
            "source_file": [],
            "source_raw": [
              {
                "data": "#cloud-config\npackage_upgrade: false\nusers:\n  - name: user\n    groups: [adm, sudo]\n    lock-passwd: false\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    passwd: $6$tGz.h5alKsD5IOP2$yfQ1RTnXjdLnmCQxFG70Jf3d24YAb8Bsb/qZ/iW0aokkahPQ8qlRhgC2ZpVYkcK.CQh579k3IF3f2LTDAMsKH/\n    ssh_authorized_keys: \n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP1oFq0GYt8j7vg2nNAJNzwBtqrdOUDp8CMQwLRiz4Vz user@ull\n\nssh_pwauth: True ## This line enables ssh password authentication\n\nwrite_files:\n  - path: /opt/iptables.rules\n    permissions: '0755'\n    content: |\n      # Generated by iptables-save v1.8.10 (nf_tables) on Mon Dec  8 15:56:30 2025\n      *filter\n      :INPUT ACCEPT [9920:2637840]\n      :FORWARD DROP [0:0]\n      :OUTPUT ACCEPT [9965:916160]\n      :DOCKER - [0:0]\n      :DOCKER-BRIDGE - [0:0]\n      :DOCKER-CT - [0:0]\n      :DOCKER-FORWARD - [0:0]\n      :DOCKER-INTERNAL - [0:0]\n      :DOCKER-USER - [0:0]\n      -A FORWARD -j DOCKER-USER\n      -A FORWARD -j DOCKER-FORWARD\n      -A FORWARD -i ens20 -o ens19 -d 10.0.0.111 -m comment --comment \"Allow immich server from sitea1\" -j ACCEPT\n      -A FORWARD -i ens21 -o ens19 -d 10.0.0.111 -m comment --comment \"Allow immich server from siteb1\" -j ACCEPT\n      -A FORWARD -i ens19 -o ens20 -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment \"Allow established/related forwarded connections\" -j ACCEPT\n      -A FORWARD -i ens18 -o ens20 -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment \"Allow established/related forwarded connections\" -j ACCEPT\n      -A FORWARD -i ens18 -o ens21 -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment \"Allow established/related forwarded connections\" -j ACCEPT\n      -A FORWARD -i ens19 -o ens21 -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment \"Allow established/related forwarded connections\" -j ACCEPT\n      -A FORWARD -d 192.168.0.0/16 -m comment --comment \"IANA networks DROP\" -j DROP\n      -A FORWARD -d 172.16.0.0/12 -m comment --comment \"IANA networks DROP\" -j DROP\n      -A FORWARD -d 10.0.0.0/8 -m comment --comment \"IANA networks DROP\" -j DROP\n      -A FORWARD -i ens20 -o ens18 -m comment --comment \"ALLOW INTERNET\" -j ACCEPT\n      -A FORWARD -i ens21 -o ens18 -m comment --comment \"ALLOW INTERNET\" -j ACCEPT\n      -A FORWARD -j LOG --log-prefix \"FORWARD DROP: \"\n      -A DOCKER ! -i docker0 -o docker0 -j DROP\n      -A DOCKER-BRIDGE -o docker0 -j DOCKER\n      -A DOCKER-CT -o docker0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT\n      -A DOCKER-FORWARD -j DOCKER-CT\n      -A DOCKER-FORWARD -j DOCKER-INTERNAL\n      -A DOCKER-FORWARD -j DOCKER-BRIDGE\n      -A DOCKER-FORWARD -i docker0 -j ACCEPT\n      COMMIT\n      # Completed on Mon Dec  8 15:56:30 2025\n      # Generated by iptables-save v1.8.10 (nf_tables) on Mon Dec  8 15:56:30 2025\n      *nat\n      :PREROUTING ACCEPT [51:3195]\n      :INPUT ACCEPT [0:0]\n      :OUTPUT ACCEPT [0:0]\n      :POSTROUTING ACCEPT [5:300]\n      :DOCKER - [0:0]\n      -A PREROUTING -m addrtype --dst-type LOCAL -j DOCKER\n      -A OUTPUT ! -d 127.0.0.0/8 -m addrtype --dst-type LOCAL -j DOCKER\n      -A POSTROUTING -j LOG --log-prefix \"POSTROUTING : \"\n      -A POSTROUTING -s 172.17.0.0/16 ! -o docker0 -j MASQUERADE\n      -A POSTROUTING -o ens19 -j SNAT --to-source 10.0.0.254\n      -A POSTROUTING -s 10.11.0.2/32 -o ens18 -j SNAT --to-source 192.168.1.113\n      -A POSTROUTING -s 10.12.0.2/32 -o ens18 -j SNAT --to-source 192.168.1.113\n      COMMIT\n      # Completed on Mon Dec  8 15:56:30 2025    \n\n# commands from here are run as root\nruncmd:\n  - echo \"Ready\"\n  - sysctl -w net.ipv4.ip_forward=1\n  - iptables-restore \u003c /opt/iptables.rules\n\n",
                "file_name": "nginx-ci-user.yml",
                "resize": 0
              }
