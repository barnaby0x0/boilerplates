            "source_raw": [
              {
                "data": "#cloud-config\npackage_upgrade: false\nusers: []\n\nssh_pwauth: True ## This line enables ssh password authentication\n\n\nwrite_files:\n  - path: /home/user/.secrets/ci-env-auth\n    permissions: \"0600\"\n    owner: user:users\n    content: |\n      CI_SERVER_URL=https://gitlab.com\n      CI_SERVER_TOKEN=glrt-5pmmPm_FnMG3-oXd_tLw82c6MTlmaDZ3Cm86MQp0OjIKdToyZ2lzZhg.01.1j1t6q2g4\n      \n\n\n\n# commands from here are run as root\nruncmd:\n  - echo \"Ready\"\n  - echo Hello \u003e /tmp/test\n  - nix-channel --add https://nixos.org/channels/nixpkgs-unstable nixpkgs\n  - nix-channel --update nixpkgs\n\n",
                "file_name": "runner-nixos-ci-user.yml",
                "resize": 0
              }
            ],
            "timeout_upload": 1800
          },
