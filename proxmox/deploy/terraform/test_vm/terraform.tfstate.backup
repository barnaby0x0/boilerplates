            "source_raw": [
              {
                "data": "#cloud-config\npackage_upgrade: false\nhostname: testvm-1\nusers:\n  - name: user\n    groups: [adm, sudo]\n    lock-passwd: false\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    passwd: $6$tGz.h5alKsD5IOP2$yfQ1RTnXjdLnmCQxFG70Jf3d24YAb8Bsb/qZ/iW0aokkahPQ8qlRhgC2ZpVYkcK.CQh579k3IF3f2LTDAMsKH/\n    ssh_authorized_keys: \n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP1oFq0GYt8j7vg2nNAJNzwBtqrdOUDp8CMQwLRiz4Vz user@ull\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKptwbs9lkk56DbyH8WXpSESgqiRDPHRjgI/grUPi4Vm user@nixos\n\n\nssh_pwauth: True ## This line enables ssh password authentication\n\n\nwrite_files:\n  - path: /etc/resolv.conf\n    permissions: \"0644\"\n    owner: root:root\n    content: |\n      nameserver 8.8.8.8\n      nameserver 8.8.4.4\n      \n\n\n\n# commands from here are run as root\nruncmd:\n  - echo \"Ready\"\n  - echo 192.168.1.29:8080 \u003e /home/user/proof\n\n",
                "file_name": "testvm-1-ci-user.yml",
                "resize": 0
              }
            ],
            "timeout_upload": 1800
