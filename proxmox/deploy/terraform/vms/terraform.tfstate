        {
          "index_key": "vault_1",
          "schema_version": 0,
          "attributes": {
            "content_type": "snippets",
            "datastore_id": "snippets",
            "file_mode": null,
            "file_modification_date": null,
            "file_name": "vault-1-ci-user.yml",
            "file_size": null,
            "file_tag": null,
            "id": "snippets:snippets/vault-1-ci-user.yml",
            "node_name": "pve",
            "overwrite": true,
            "source_file": [],
            "source_raw": [
              {
                "data": "#cloud-config\npackage_upgrade: false\nhostname: vault-1\nusers:\n  - name: user\n    groups: [adm, sudo]\n    lock-passwd: false\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    passwd: $6$tGz.h5alKsD5IOP2$yfQ1RTnXjdLnmCQxFG70Jf3d24YAb8Bsb/qZ/iW0aokkahPQ8qlRhgC2ZpVYkcK.CQh579k3IF3f2LTDAMsKH/\n    ssh_authorized_keys: \n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP1oFq0GYt8j7vg2nNAJNzwBtqrdOUDp8CMQwLRiz4Vz user@ull\n\n\nssh_pwauth: True ## This line enables ssh password authentication\n\n\nwrite_files:\n  - path: /home/user/vault/config.hcl\n    permissions: \"0600\"\n    content: |\n      storage \"raft\" {\n        path    = \"/vault/data\"\n        node_id = \"vault1\"\n      }\n      \n      listener \"tcp\" {\n        address     = \"0.0.0.0:8200\"\n        tls_disable = \"true\"\n      }\n      \n      api_addr      = \"http://127.0.0.1:8200\"\n      cluster_addr  = \"http://127.0.0.1:8201\"\n      ui            = true\n      disable_mlock = true\n      \n  - path: /home/user/vault/policy_terraform.hcl\n    permissions: \"0600\"\n    content: |\n      # kv2 secret/terraform/*\n      path \"secret/data/terraform/*\" {\n         capabilities = [ \"create\", \"read\", \"update\", \"delete\", \"list\" ]\n      }\n      \n      path \"secret/metadata/terraform/*\" {\n         capabilities = [ \"create\", \"read\", \"update\", \"delete\", \"list\" ]\n      }\n      \n      # Mount the AppRole auth method\n      path \"sys/auth/approle\" {\n        capabilities = [ \"create\", \"read\", \"update\", \"delete\", \"sudo\" ]\n      }\n      \n      # Configure the AppRole auth method\n      path \"sys/auth/approle/*\" {\n        capabilities = [ \"create\", \"read\", \"update\", \"delete\" ]\n      }\n      \n      # Create and manage roles\n      path \"auth/approle/*\" {\n        capabilities = [ \"create\", \"read\", \"update\", \"delete\", \"list\" ]\n      }\n      \n      # Write ACL policies\n      path \"sys/policies/acl/*\" {\n        capabilities = [ \"create\", \"read\", \"update\", \"delete\", \"list\" ]\n      }\n      \n  - path: /home/user/docker-compose.yaml\n    permissions: \"0600\"\n    content: |\n      services:\n        vault:\n          image: hashicorp/vault:${VAULT_VERSION}\n          container_name: vault\n          ports:\n            - 8200:8200\n          volumes:\n            - ./vault/config.hcl:/vault/config/config.hcl\n            - ./vault/data:/vault/data\n          environment:\n            VAULT_ADDR: http://127.0.0.1:8200\n          entrypoint: vault server -config=/vault/config/config.hcl\n          cap_add:\n            - IPC_LOCK\n      \n  - path: /home/user/.env\n    permissions: \"0600\"\n    content: |\n      VAULT_VERSION=1.21\n      \n\n\n\n# commands from here are run as root\nruncmd:\n  - echo \"Ready\"\n  - usermod -aG docker user\n  - chown -R user:users /home/user\n  - sudo -H -u user bash -c 'cd /home/user; docker compose up -d'\n\n",
                "file_name": "vault-1-ci-user.yml",
                "resize": 0
              }
            ],
            "timeout_upload": 1800
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
      ]
