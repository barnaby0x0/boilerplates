      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "-",
            "program": [
              "bash",
              "-c",
              "    if nc -z -w 3 \"10.0.0.112\" 22 \u003e/dev/null 2\u003e\u00261; then\n      echo '{\"reachable\": \"true\", \"message\": \"OK\"}'\n    else\n      echo '{\"reachable\": \"false\", \"message\": \"Serveur 10.0.0.112 non joignable (port 22)\"}'\n    fi\n"
            ],
            "query": null,
            "result": {
              "message": "OK",
              "reachable": "true"
            },
            "working_dir": null
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0
        }
      ]
