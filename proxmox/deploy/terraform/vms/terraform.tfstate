              {
                "data": "#cloud-config\npackage_upgrade: false\nhostname: swarm-manager-1\nusers:\n  - name: user\n    groups: [adm, sudo]\n    lock-passwd: false\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    passwd: $6$tGz.h5alKsD5IOP2$yfQ1RTnXjdLnmCQxFG70Jf3d24YAb8Bsb/qZ/iW0aokkahPQ8qlRhgC2ZpVYkcK.CQh579k3IF3f2LTDAMsKH/\n    ssh_authorized_keys: \n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP1oFq0GYt8j7vg2nNAJNzwBtqrdOUDp8CMQwLRiz4Vz user@ull\n\n\nssh_pwauth: True ## This line enables ssh password authentication\n\n\n\n# commands from here are run as root\nruncmd:\n  - echo \"Ready\"\n  - usermod -aG docker user\n  - apk add curl tcpdump netcat-openbsd vim\n  - sudo -H -u user bash -c 'docker swarm init --default-addr-pool 10.20.0.0/16 --default-addr-pool-mask-length 24'\n  - sudo -H -u user bash -c 'curl -L https://downloads.portainer.io/ce-lts/portainer-agent-stack.yml -o /home/user/portainer-agent-stack.yml'\n  - sudo -H -u user bash -c 'docker stack deploy -c /home/user/portainer-agent-stack.yml portainer'\n  - sudo -H -u user bash -c 'docker swarm join-token -q worker'\n\n",
