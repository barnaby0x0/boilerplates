            "source_file": [],
            "source_raw": [
              {
                "data": "#cloud-config\npackage_upgrade: false\nhostname: testmachinealpine-1\nusers:\n  - name: user\n    groups: [adm, sudo]\n    lock-passwd: false\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    passwd: $6$tGz.h5alKsD5IOP2$yfQ1RTnXjdLnmCQxFG70Jf3d24YAb8Bsb/qZ/iW0aokkahPQ8qlRhgC2ZpVYkcK.CQh579k3IF3f2LTDAMsKH/\n    ssh_authorized_keys: \n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP1oFq0GYt8j7vg2nNAJNzwBtqrdOUDp8CMQwLRiz4Vz user@ull\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKptwbs9lkk56DbyH8WXpSESgqiRDPHRjgI/grUPi4Vm user@nixos\n\n\nssh_pwauth: True ## This line enables ssh password authentication\n\n\nwrite_files:\n  - path: /etc/resolv.conf\n    permissions: \"0644\"\n    owner: root:root\n    content: |\n      nameserver 8.8.8.8\n      nameserver 8.8.4.4\n      \n  - path: /home/user/cmd\n    permissions: \"0755\"\n    content: |\n      #!/bin/sh\n      #ssh user@10.10.0.12 \"docker run -t -v nix-store:/nix 10.0.0.250:5000/nixos-anywhere bash -ic \\\"colmena --help\\\"\"\n      #ssh user@10.10.0.12 \"docker run -t -v nix-store:/nix 10.0.0.250:5000/nixos-anywhere bash -ic \\\"nix-shell -p iputils --run 'ping -c2 10.0.0.90'\\\"\"\n      ssh user@10.10.0.12 \"docker run -e SSHPASS=toor -t -v nix-store:/nix 10.0.0.250:5000/nixos-anywhere bash -ic \\\"nix-shell -p nixos-anywhere --run 'nixos-anywhere --flake .#serveur --build-on local --env-password --option require-sigs false --debug user@10.0.0.90'\\\"\"\n      \n\n\n\n# commands from here are run as root\nruncmd:\n  - echo \"Ready\"\n  - usermod -aG docker user\n\n",
                "file_name": "testmachinealpine-1-ci-user.yml",
                "resize": 0
              }
            ],
            "timeout_upload": 1800
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
