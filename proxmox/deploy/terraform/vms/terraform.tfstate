                "data": "#cloud-config\npackage_upgrade: false\nusers:\n  - name: user\n    groups: [adm, sudo]\n    lock-passwd: false\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    passwd: $6$tGz.h5alKsD5IOP2$yfQ1RTnXjdLnmCQxFG70Jf3d24YAb8Bsb/qZ/iW0aokkahPQ8qlRhgC2ZpVYkcK.CQh579k3IF3f2LTDAMsKH/\n    ssh_authorized_keys: \n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP1oFq0GYt8j7vg2nNAJNzwBtqrdOUDp8CMQwLRiz4Vz user@ull\n\n\nssh_pwauth: True ## This line enables ssh password authentication\n\n\n\n# commands from here are run as root\nruncmd:\n  - echo \"Ready\"\n  - usermod -aG docker user\n  - su - user -c \"mkdir /home/user/nginx\"\n  - su - user -c \"cd /home/user/nginx; wget http://192.168.1.31:8080/files/nginxproxymanager/configs/docker-compose.yml\"\n  - su - user -c \"cd /home/user/nginx; wget http://192.168.1.31:8080/files/nginxproxymanager/data/data.tgz\"\n  - su - user -c \"cd /home/user/nginx; wget http://192.168.1.31:8080/files/nginxproxymanager/data/letsencrypt.tgz\"\n  - su - user -c \"cd /home/user/nginx; tar xvzf data.tgz \u0026\u0026 tar xvzf letsencrypt.tgz \u0026\u0026 rm data.tgz letsencrypt.tgz\"\n  - su - user -c \"cd /home/user/nginx; docker-compose up -d\"\n\n",
