                "data": "#cloud-config\npackage_upgrade: false\nusers:\n  - name: user\n    groups: [adm, sudo]\n    lock-passwd: false\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    passwd: $6$tGz.h5alKsD5IOP2$yfQ1RTnXjdLnmCQxFG70Jf3d24YAb8Bsb/qZ/iW0aokkahPQ8qlRhgC2ZpVYkcK.CQh579k3IF3f2LTDAMsKH/\n    ssh_authorized_keys: \n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP1oFq0GYt8j7vg2nNAJNzwBtqrdOUDp8CMQwLRiz4Vz user@ull\n\n\nssh_pwauth: True ## This line enables ssh password authentication\n\n\nwrite_files:\n  - path: /tmp/run.sh\n    permissions: \"0755\"\n    content: |\n      apk add jq\n      \n  - path: /etc/gitlab-runner/config.toml\n    permissions: \"0600\"\n    content: |\n      concurrent = 1\n      check_interval = 0\n      connection_max_age = \"15m0s\"\n      shutdown_timeout = 0\n      \n      [session_server]\n        session_timeout = 1800\n      \n      [[runners]]\n        name = \"ubuntu\"\n        url = \"https://gitlab.com\"\n        id = 51778466\n        token = \"glrt-VFMyGfu6Ah7wPaJ84NDp2mc6MTlmaDZ3Cm86MQp0OjIKdToyZ2lzZhg.01.1j1och5b2\"\n        token_obtained_at = 2026-02-13T10:57:09Z\n        token_expires_at = 0001-01-01T00:00:00Z\n        executor = \"docker\"\n        [runners.cache]\n          MaxUploadedArchiveSize = 0\n          [runners.cache.s3]\n          [runners.cache.gcs]\n          [runners.cache.azure]\n        [runners.docker]\n          tls_verify = false\n          image = \"alpine\"\n          privileged = true\n          disable_entrypoint_overwrite = false\n          oom_kill_disable = false\n          disable_cache = false\n          volumes = [\n            \"/cache\",\n          ]      \n          shm_size = 0\n          network_mtu = 0         \n      \n\n\n\n# commands from here are run as root\nruncmd:\n  - echo \"Ready\"\n  - mkdir -p /etc/gitlab-runner\n  - curl -L https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.deb.sh | sudo bash\n  - apt-get install gitlab-runner jq -y\n  - systemctl enable --now gitlab-runner\n\n",
