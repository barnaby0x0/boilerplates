            "content_type": "snippets",
            "datastore_id": "snippets",
            "file_mode": null,
            "file_modification_date": null,
            "file_name": "registry-ci-user.yml",
            "file_size": null,
            "file_tag": null,
            "id": "snippets:snippets/registry-ci-user.yml",
            "node_name": "pve",
            "overwrite": true,
            "source_file": [],
            "source_raw": [
              {
                "data": "#cloud-config\npackage_upgrade: false\nusers:\n  - name: user\n    groups: [adm, sudo]\n    lock-passwd: false\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    passwd: $6$tGz.h5alKsD5IOP2$yfQ1RTnXjdLnmCQxFG70Jf3d24YAb8Bsb/qZ/iW0aokkahPQ8qlRhgC2ZpVYkcK.CQh579k3IF3f2LTDAMsKH/\n    ssh_authorized_keys: \n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP1oFq0GYt8j7vg2nNAJNzwBtqrdOUDp8CMQwLRiz4Vz user@ull\n\n\nssh_pwauth: True ## This line enables ssh password authentication\n\n\nwrite_files:\n  - path: /home/user/docker-compose.yaml\n    permissions: 0700\n    content: |\n      services:\n        registry:\n          image: registry:latest\n          environment:\n            REGISTRY_AUTH: htpasswd # TODO: make it work with password + cache\n            REGISTRY_AUTH_HTPASSWD_REALM: Registry Realm\n            REGISTRY_AUTH_HTPASSWD_PATH: /auth/registry.password\n            REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY: /data\n          volumes:\n            # Mount the password file\n            - /home/user/registry/registry.password:/auth/registry.password\n            # Mount the data directory\n            - /home/user/registry/data:/data\n          ports:\n            - 0.0.0.0:5000:5000\n          restart: unless-stopped\n      \n        registry-proxy-cache:\n          image: registry:latest\n          environment:\n            REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY: /data\n            REGISTRY_PROXY_REMOTEURL: https://registry-1.docker.io\n          volumes:\n            # Mount the data directory\n            - /home/user/registry-proxy-cache/data:/data\n          ports:\n            - 0.0.0.0:5001:5000\n          restart: unless-stopped          \n      \n  - path: /home/user/registry/registry.password\n    permissions: 0700\n    content: |\n      victor:$2y$05$B1NBFhshYeRpHfcBohYFduBAlutF.RlybVZyK0ePLprfgbPyvzUci\n      \n\n\n\n# commands from here are run as root\nruncmd:\n  - echo \"Ready\"\n  - usermod -aG docker user\n  - mkdir -p /home/user/registry/data\n  - mkdir -p /home/user/registry-proxy-cache/data\n  - chown -R user:user /home/user/{registry, registry-proxy-cache}\n  - chown user:user /home/user/docker-compose.yaml\n  - su -l user -c \"cd /home/user \u0026\u0026 docker compose up -d\"\n\n",
                "file_name": "registry-ci-user.yml",
                "resize": 0
              }
            ],
            "timeout_upload": 1800
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        },
