            "overwrite": true,
            "source_file": [],
            "source_raw": [
              {
                "data": "#cloud-config\npackage_upgrade: false\nusers:\n  - name: user\n    groups: [adm, sudo]\n    lock-passwd: false\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    passwd: $6$tGz.h5alKsD5IOP2$yfQ1RTnXjdLnmCQxFG70Jf3d24YAb8Bsb/qZ/iW0aokkahPQ8qlRhgC2ZpVYkcK.CQh579k3IF3f2LTDAMsKH/\n    ssh_authorized_keys: \n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP1oFq0GYt8j7vg2nNAJNzwBtqrdOUDp8CMQwLRiz4Vz user@ull\n\n\nssh_pwauth: True ## This line enables ssh password authentication\n\n\nwrite_files:\n  - path: /etc/docker/daemon.json\n    permissions: 0600\n    content: |\n      {\n        \"insecure-registries\": [\n          \"10.0.0.250:5000\"\n        ]\n      }\n      \n  - path: /home/user/links.txt\n    permissions: 0755\n    content: |\n      https://mamot.fr/@YggTorrent\n      http://localhost:9091/transmission/web/\n      https://www.myip.com/\n      \n\n\n\n# commands from here are run as root\nruncmd:\n  - echo \"Ready\"\n  - usermod -aG docker user\n  - mkdir -p /etc/docker\n  - mkdir /home/user/downloader\n  - cd /home/user/downloader; wget http://192.168.1.31:8080/files/downloader/docker-compose.yaml\n  - /home/user/downloader; wget http://192.168.1.31:8080/files/downloader/.env\n  - mkdir -p /home/user/containers/downloader/transmission/downloads\n  - mkdir -p /home/user/.secret/vpn/wg_confs\n  - mkdir -p /home/user/containers/downloader/firefox/Downloads/new\n  - mkdir -p /home/user/containers/downloader/desktop/home/user/Downloads\n  - mkdir -p /home/user/containers/downloader/desktop/home/user/.mozilla\n  - mkdir -p /home/user/containers/downloader/transmission/downloads/complete\n  - chown -R user:user /home/user/downloader\n  - chown -R user:user /home/user/containers\n  - chown -R user:user /home/user/.secret\n  - service docker restart\n\n",
                "file_name": "downloader-ci-user.yml",
                "resize": 0
              }
            ],
            "timeout_upload": 1800
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
