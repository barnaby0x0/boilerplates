#cloud-config
package_upgrade: false
users:
%{ for user in users ~}
  - name: ${user.name}
    groups: ${user.groups}
    lock-passwd: ${user.lock_passwd}
    sudo: ${user.sudo}
    shell: ${user.shell}
    passwd: ${user.password}
    ssh_authorized_keys: ${user.ssh_authorized_keys}
%{~ endfor }

ssh_pwauth: True ## This line enables ssh password authentication

write_files:
  - path: /opt/iptables.rules
    permissions: '0755'
    content: |
      # Generated by iptables-save v1.8.10 (nf_tables) on Mon Dec  8 15:56:30 2025
      *filter
      :INPUT ACCEPT [9920:2637840]
      :FORWARD DROP [0:0]
      :OUTPUT ACCEPT [9965:916160]
      :DOCKER - [0:0]
      :DOCKER-BRIDGE - [0:0]
      :DOCKER-CT - [0:0]
      :DOCKER-FORWARD - [0:0]
      :DOCKER-INTERNAL - [0:0]
      :DOCKER-USER - [0:0]
      -A FORWARD -j DOCKER-USER
      -A FORWARD -j DOCKER-FORWARD
      -A FORWARD -i ens20 -o ens19 -d 10.0.0.111 -m comment --comment "Allow immich server from sitea1" -j ACCEPT
      -A FORWARD -i ens21 -o ens19 -d 10.0.0.111 -m comment --comment "Allow immich server from siteb1" -j ACCEPT
      -A FORWARD -i ens19 -o ens20 -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "Allow established/related forwarded connections" -j ACCEPT
      -A FORWARD -i ens18 -o ens20 -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "Allow established/related forwarded connections" -j ACCEPT
      -A FORWARD -i ens18 -o ens21 -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "Allow established/related forwarded connections" -j ACCEPT
      -A FORWARD -i ens19 -o ens21 -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "Allow established/related forwarded connections" -j ACCEPT
      -A FORWARD -d 192.168.0.0/16 -m comment --comment "IANA networks DROP" -j DROP
      -A FORWARD -d 172.16.0.0/12 -m comment --comment "IANA networks DROP" -j DROP
      -A FORWARD -d 10.0.0.0/8 -m comment --comment "IANA networks DROP" -j DROP
      -A FORWARD -i ens20 -o ens18 -m comment --comment "ALLOW INTERNET" -j ACCEPT
      -A FORWARD -i ens21 -o ens18 -m comment --comment "ALLOW INTERNET" -j ACCEPT
      -A FORWARD -j LOG --log-prefix "FORWARD DROP: "
      -A DOCKER ! -i docker0 -o docker0 -j DROP
      -A DOCKER-BRIDGE -o docker0 -j DOCKER
      -A DOCKER-CT -o docker0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
      -A DOCKER-FORWARD -j DOCKER-CT
      -A DOCKER-FORWARD -j DOCKER-INTERNAL
      -A DOCKER-FORWARD -j DOCKER-BRIDGE
      -A DOCKER-FORWARD -i docker0 -j ACCEPT
      COMMIT
      # Completed on Mon Dec  8 15:56:30 2025
      # Generated by iptables-save v1.8.10 (nf_tables) on Mon Dec  8 15:56:30 2025
      *nat
      :PREROUTING ACCEPT [51:3195]
      :INPUT ACCEPT [0:0]
      :OUTPUT ACCEPT [0:0]
      :POSTROUTING ACCEPT [5:300]
      :DOCKER - [0:0]
      -A PREROUTING -m addrtype --dst-type LOCAL -j DOCKER
      -A OUTPUT ! -d 127.0.0.0/8 -m addrtype --dst-type LOCAL -j DOCKER
      -A POSTROUTING -j LOG --log-prefix "POSTROUTING : "
      -A POSTROUTING -s 172.17.0.0/16 ! -o docker0 -j MASQUERADE
      -A POSTROUTING -o ens19 -j SNAT --to-source 10.0.0.254
      -A POSTROUTING -s 10.11.0.2/32 -o ens18 -j SNAT --to-source 192.168.1.113
      -A POSTROUTING -s 10.12.0.2/32 -o ens18 -j SNAT --to-source 192.168.1.113
      COMMIT
      # Completed on Mon Dec  8 15:56:30 2025    

# commands from here are run as root
runcmd:
  - echo "Ready"
%{ for cmd in cmds ~}
  - ${cmd}
%{ endfor }
